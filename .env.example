# ── Supabase (Project Settings → API) ─────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Team password for the dashboard (leave empty to disable the login locally).
APP_PASSWORD=
# Any long random string; signs the login cookie.
SESSION_SECRET=
# 64 hex chars (openssl rand -hex 32); encrypts Google client secrets and Gmail tokens in the database.
ENCRYPTION_KEY=

# ── Google OAuth (Gmail read-only) ────────────────────────────────
# Optional fallback. Normally you add OAuth clients (and any number of mailboxes)
# in the app: Settings → Google OAuth clients / Research mailboxes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: near-real-time Gmail push via Pub/Sub
# GMAIL_PUBSUB_TOPIC=projects/YOUR-GCP-PROJECT/topics/gmail-push
# GMAIL_PUSH_TOKEN=random-string-used-in-the-push-subscription-url

# ── OpenAI (email analysis + AI analyst) ──────────────────────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# Set to false to stop sending hero images to the model (text-only analysis).
# ANALYZE_IMAGES=true

# ── Scheduled sync & forwarding ───────────────────────────────────
# Bearer token for GET /api/cron/sync (Vercel Cron sends it automatically).
CRON_SECRET=
# Bearer token for POST /api/ingest/forward (email forwarding alternative).
INGEST_SECRET=
